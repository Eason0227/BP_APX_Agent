tion \u6539\u5584 CIP \u6210\u529f \u6848\u4f8b', 'title': 'Query Text', 'type': 'string'}, 'top_k': {'default': 3, 'title': 'Top K', 'type': 'integer'}, 'agent_type': {'default': 'EE', 'title': 'Agent Type', 'type': 'string'}, 'use_sparse': {'default': False, 'title': 'Use Sparse', 'type': 'boolean'}}, 'required': ['machine_ids', 'week_range', 'query_text', 'top_k', 'agent_type', 'use_sparse'], 'title': 'search_cip_cases_batch_args', 'type': 'object', 'additionalProperties': False}, on_invoke_tool=<function function_tool.<locals>._create_function_tool.<locals>._on_invoke_tool at 0x0000024992E86160>, strict_json_schema=True, is_enabled=True, tool_input_guardrails=None, tool_output_guardrails=None)], mcp_servers=[], mcp_config={}, instructions='\u4f60\u662f\u4e00\u4f4d\u8cc7\u6df1\u7684\u8a2d\u5099\u5de5\u7a0b\u5e2b (EE)\uff0c\u5c08\u7cbe\u65bc\u534a\u5c0e\u9ad4\u88fd\u9020\u8a2d\u5099\u7570\u5e38\u8a3a\u65b7\u8207\u4fdd\u990a\u6c7a\u7b56\u3002\n                        \u4f60\u80fd\u900f\u904e\u4ee5\u4e0b\u5de5\u5177\u67e5\u8a62\u672c\u5730 Excel \u8cc7\u6599\uff0c\u4e26\u7d66\u51fa\u5177\u9ad4\u7684\u884c\u52d5\u5efa\u8b70\uff1a\n\n                        **\u5de5\u5177\u4f7f\u7528\u6307\u5f15\uff1a**\n                        1. \u8a62\u554f\u98a8\u96aa\u6982\u6cc1\uff0f\u91cd\u8907\u7570\u5e38\u6a5f\u53f0  `get_recurring_abnormal_machines`\n                        2. \u8a62\u554f\u9031\u671f\u7570\u5e38\u71b1\u9ede  `get_weekly_hotspots`\n                        3. \u63d0\u4f9b\u6574\u9ad4\u6a5f\u53f0\u72c0\u614b\u9031\u5831 `get_latest_weekly_overall_report`\n                        4. \u67e5\u8a62\u6bcf\u9031 Rework rate  `get_rework_weekly_data`\uff08\u56de\u50b3 JSON\uff0c\u542b layer_trends \u8da8\u52e2\u8cc7\u6599\uff09\n                        5. \u5075\u6e2c OP \u6f0f\u6aa2 (BY PASS) \u98a8\u96aa  `detect_rework_bypass_risk`\uff08\u6bd4\u5c0d\u76f8\u5c0d\u8fd1 4 \u9031\u5e73\u5747\u7684\u9a5f\u964d\uff0c\u56de\u50b3 JSON\uff09\n                        6. \u