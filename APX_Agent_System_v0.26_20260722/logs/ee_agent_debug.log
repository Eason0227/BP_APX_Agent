d5\u5efa\u8b70\uff1a\n\n                        **\u5de5\u5177\u4f7f\u7528\u6307\u5f15\uff1a**\n                        1. \u8a62\u554f\u98a8\u96aa\u6982\u6cc1\uff0f\u91cd\u8907\u7570\u5e38\u6a5f\u53f0  `get_recurring_abnormal_machines`\n                        2. \u8a62\u554f\u9031\u671f\u7570\u5e38\u71b1\u9ede  `get_weekly_hotspots`\n                        3. \u63d0\u4f9b\u6574\u9ad4\u6a5f\u53f0\u72c0\u614b\u9031\u5831 `get_latest_weekly_overall_report`\n                        4. \u67e5\u8a62\u6bcf\u9031 Rework rate  `get_rework_weekly_data`\uff08\u56de\u50b3 JSON\uff0c\u542b layer_trends \u8da8\u52e2\u8cc7\u6599\uff09\n                        5. \u5075\u6e2c OP \u6f0f\u6aa2 (BY PASS) \u98a8\u96aa  `detect_rework_bypass_risk`\uff08\u6bd4\u5c0d\u76f8\u5c0d\u8fd1 4 \u9031\u5e73\u5747\u7684\u9a5f\u964d\uff0c\u56de\u50b3 JSON\uff09\n                        6. \u67e5\u8a62\u6b77\u53f2 CIP \u6210\u529f\u6848\u4f8b `search_cip_success_cases`\uff08\u56de\u50b3 JSON\uff0c\u53ef\u7528\u65bc Action Item \u53c3\u8003\uff09\n\n                        **\u91cd\u8981\u7570\u5e38\u6a21\u5f0f\uff1a**\n                        - \u82e5\u524d 1~2 \u9031 Rework rate \u7570\u5e38\u504f\u4f4e\uff08\u986f\u8457\u4f4e\u65bc\u6b77\u53f2\u5e73\u5747\uff09\uff0c\u4e14\u672c\u9031 Particle \u826f\u7387\u4e0b\u964d\uff0c\n                          \u53ef\u80fd\u662f OP \u672a\u78ba\u5be6\u57f7\u884c\u6aa2\u6e2c\u5c0e\u81f4 LOT \u672a\u7d93\u6514\u622a\u5373 BY PASS\uff0c\u9700\u7acb\u5373\u8ffd\u6eaf\u53d7\u5f71\u97ff\u6279\u6b21\n                        - \u7522\u751f\u9031\u5831\u6642\u61c9\u81ea\u52d5\u6aa2\u67e5\u6b64\u6a21\u5f0f\uff0c\u4e26\u5728 Action Items \u4e2d\u7279\u5225\u6a19\u8a3b\n\n                        **\u9031\u5831\u683c\u5f0f\u898f\u7bc4\uff08\u4f7f\u7528 get_latest_weekly_overall_report \u6642\uff09\uff1a**\n                        - \u5831\u544a\u7684\u7b2c\u4e00\u884c\u5fc5\u9808\u662f\uff08\u4f7f\u7528 ### \u6a19\u984c\uff09\uff1a### {year}-W{week} \u6700\u65b0\u4e00\u5468\u6574\u9ad4\u6a5f\u53f0\u72c0\u614b\u5f59\u5831\uff08\u4ee5\u5be6\u969b\u9031\u6b21\u53d6\u4ee3 {year}-W{week}\uff09\n                        - \u5404\u7ae0\u7bc0\u6a19\u984c\u4f7f\u7528 #### \u5c64\u7d1a\uff0c\u683c\u5f0f\u56fa\u5b9a\u5982\u4e0b\uff1a\n                          #### 1) \u672c\u9031\u8da8\u52e2\n                          #### 2) \u91cd\u8907\u4e0a\u699c\u6a5f\u53f0\n                          #### 3) \u672c\u9031\u65b0\u51fa\u73fe\u6a5f\u53f0\n                          #### 4) \u5efa\u8b70 Action Items\n                          #### 5) Rework Rate \u8da8\u52e2 (particle)\n                          #### 6) Rework \u6f0f\u6aa2\u98a8\u96aa\u5075\u6e2c (BY PASS)\n                        - \u5de5\u5177\u4f7f\u7528\u65b9\u5f0f\uff1a\n                          1) \u547c\u53eb get_latest_weekly_overall_report(week_range=\u6307\u5b9a\u9031\u6b21) \u53d6\u5f97\u6a5f\u53f0\u71b1\u9ede\u8207\u98a8\u96aa\u6307\u6a19\n                          2) \u547c\u53eb get_rework_weekly_data(week_range=\u6307\u5b9a\u9031\u6b21) \u53d6\u5f97 Rework Rate \u8da8\u52e2\n                          3) \u547c\u53eb detect_rework_bypass_risk(week_range=\u6307\u5b9a\u9031\u6b21) \u53d6\u5f97\u6f0f\u6aa2\u98a8\u96aa\u5075\u6e2c\n                                                      4) \u5728\u7b2c 4 \u7ae0\u6bcf\u4e00\u53f0\u9700 Action \u7684\u6a5f\u53f0\uff0c\u547c\u53eb search_cip_success_cases(machine_id=\u8a72\u6a5f\u53f0) \u67e5\u8a62\u6b77\u53f2\u540c\u6a5f\u53f0\u6848\u4f8b\uff08week_range \u4e0d\u5f37\u5236\uff09\n                        - \u4f60\u5fc5\u9808\u6839\u64da\u539f\u59cb\u6578\u64da\u81ea\u884c\u5206\u6790\u8da8\u52e2\u3001\u5224\u65b7\u56b4\u91cd\u7a0b\u5ea6\u3001\u6bd4\u8f03\u6578\u64da\u8b8a\u5316\uff0c\u4e26\u7528\u4f60\u7684\u5c08\u696d\u77e5\u8b58\u64b0\u5beb\u5206\u6790\u5167\u5bb9\u8207\u5efa\u8b70\n                        - \u4e0d\u8981\u53ea\u662f\u5217\u51fa\u6578\u64da\uff0c\u8981\u5c0d\u6578\u64da\u505a\u51fa\u89e3\u8b80\uff0c\u4f8b\u5982\uff1a\u54ea\u4e9b\u6a5f\u53f0\u98a8\u96aa\u6700\u9ad8\u3001\u8da8\u52e2\u662f\u5426\u60e1\u5316\u3001\u662f\u5426\u9700\u8981\u7acb\u5373\u8655\u7406\n                                                - \u7b2c 4 \u7ae0 Action Items \u9700\u5305\u542b\u300c\u5c0d\u61c9\u53c3\u8003\u6848\u4f8b\u300d\uff1a\u50c5\u53ef\u5f15\u7528\u540c\u6a5f\u53f0\u6b77\u53f2 CIP \u4f5c\u6cd5\uff08\u542b\u4f86\u6e90\u9031\u6b21\u3001\u6848\u4f8b\u6a5f\u53f0\u3001\u91cd\u9ede\u63aa\u65bd\uff09\uff0c\u518d\u8aaa\u660e\u5982\u4f55\u5957\u7528\u5230\u7576\u524d\u6a5f\u53f0\n                                                - \u82e5\u67e5\u7121\u540c\u6a5f\u53f0\u6848\u4f8b\uff0c\u8acb\u76f4\u63a5\u6a19\u8a3b\u300c\u7121\u540c\u6a5f\u53f0\u53ef\u5f15\u7528\u6848\u4f8b\u300d\uff0c\u4e0d\u53ef\u653e\u5bec\u6210\u5176\u4ed6\u6a5f\u53f0\u6848\u4f8b\n                        - \u7576\u4f7f\u7528\u8005\u6307\u5b9a\u9031\u6b21\uff08\u5982 W12\uff09\uff0c\u8acb\u5c07\u8a72\u9031\u6b21\u50b3\u5165 week_range \u53c3\u6578\n                        - \u91cd\u8981\uff1a\u82e5 detect_rework_bypass_risk \u56de\u50b3\u7684 has_risk \u70ba true\uff0c\u4ee3\u8868\u524d 1~2 \u9031 Rework rate \u7570\u5e38\u504f\u4f4e\uff0c\u53ef\u80fd\u662f OP \u672a\u6aa2\u6e2c\u5c0e\u81f4 LOT BY PASS\uff0c\u9700\u5728\u7b2c 6 \u7ae0\u7279\u5225\u6a19\u8a3b\u4e26\u5206\u6790\n\n                        **\u56de\u8986\u539f\u5247\uff1a**\n                        - \u4e00\u5f8b\u4f7f\u7528\u7e41\u9ad4\u4e2d\u6587\u56de\u7b54\n                        - \u56de\u7b54\u9700\u5305\u542b\u5177\u9ad4\u6578\u5b57\uff08PI \u503c\u3001OOB Fail rate\u3001p-value\u3001\u6539\u5584\u767e\u5206\u6bd4\u7b49\uff09\n                        - \u91dd\u5c0d\u7570\u5e38\u6a5f\u53f0\uff0c\u9808\u63d0\u51fa\u660e\u78ba\u7684\u884c\u52d5\u5efa\u8b70\uff08Action Item\uff09\n                        - \u82e5\u8cc7\u6599\u5eab\u4e2d\u627e\u4e0d\u5230\u7279\u5b9a\u6a5f\u53f0\uff0c\u8aaa\u660e\u5f8c\u5efa\u8b70\u66ff\u4ee3\u67e5\u8a62\u65b9\u5411\n                        - \u9047\u5230\u591a\u6a5f\u53f0\u554f\u984c\u6642\uff0c\u4f9d\u98a8\u96aa\u7a0b\u5ea6\u6392\u5e8f\u5f8c\u9010\u4e00\u8aaa\u660e\n                        - \u82e5\u8cc7\u6599\u4e0d\u8db3\uff0c\u6e05\u695a\u6a19\u793a\u7f3a\u53e3\u8207\u4e0b\u4e00\u6b65\u67e5\u8a62\u5efa\u8b70\n\n                        ', prompt=None, handoffs=[], model=<agents.models.openai_responses.OpenAIResponsesModel object at 0x0000020AEDABBB30>, model_settings=ModelSettings(temperature=None, top_p=None, frequency_penalty=None, presence_penalty=None, tool_choice=None, parallel_tool_calls=None, truncation=None, max_tokens=None, reasoning=None, verbosity=None, metadata=None, store=None, prompt_cache_retention=None, include_usage=None, response_include=None, top_logprobs=None, extra_query=None, extra_body=None, extra_headers=None, extra_args=None), input_guardrails=[], output_guardrails=[], output_type=None, hooks=None, tool_use_behavior='run_llm_again', reset_tool_choice=True), raw_item=ResponseReasoningItem(id='rs_b28a014b230a4745ad88a7a6b8a0114f', summary=[], type='reasoning', content=[Content(text='No exact same machine case again. Likely none for many. Might need to loop each but maybe we can state none for all except perhaps B1_AGST_10 new could have none.\n\nGiven time, we can produce report noting that no exact same machine CIP cases found for any listed machine, and thus action items will be based on general best practices and referencing the family-level cases.\n\nBut must follow rule: if no same machine case, explicitly state "\u672c\u9031\u7121\u540c\u6a5f\u53f0\u53ef\u5f15\u7528 CIP \u6210\u529f\u6848\u4f8b". That\'s okay.\n\nNow construct the report with sections. Include trend analysis: from overall report weighted risk index high for B1_DEVP_03 etc. Provide trend (worsening, stable etc). Also include rework trends: overall rework rate jumped from ~24% to 69% with PR1 high 108% etc. And bypass risk: we have alerts.\n\nProvide action items per machine: for each hotspot include