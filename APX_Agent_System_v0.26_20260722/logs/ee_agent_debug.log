raw_responses=[ModelResponse(output=[ResponseReasoningItem(id='rs_2a887a0dac1a4ca8a53d0fcf0aeffc4b', summary=[], type='reasoning', content=[Content(text="We need to generate the weekly report. Must call get_latest_weekly_overall_report for latest week. Also need rework data and bypass risk. Then compile. Steps: call get_latest_weekly_overall_report with empty week_range to get latest. Then get rework weekly data, then detect bypass risk. Then need action items with CIP cases. We need to identify machines from report: repeated abnormal machines, new machines. Use search_cip_cases_batch with those machine ids.\n\nLet's first call get_latest_weekly_overall_report.", type='reasoning_text')], encrypted_content=None, status=None), ResponseFunctionToolCall(arguments='{\n  "week_range": "",\n  "top_k": 15\n}', call_id='call_fae1fb18b6c44d79a6c3172d81620eec', name='get_latest_weekly_overall_report', type='function_call', id='ft_fae1fb18b6c44d79a6c3172d81620eec', status=None)], usage=Usage(requests=1, input_tokens=0, input_tokens_details=InputTokensDetails(cached_tokens=0), output_tokens=0, output_tokens_details=OutputTokensDetails(reasoning_tokens=0), total_tokens=0, request_usage_entries=[]), response_id='resp_9c1d076a8deb4b2f8cf8120aef7d0a23'), ModelResponse(output=[ResponseReasoningItem(id='rs_ca5f010e624b4a81b96b8892d9b28543', summary=[], type='reasoning', content=[Content(text='We have data: week_range 2026-W23, repeated machines list (11?), new machine list (1). Need to provide sections.\n\nNow need rework weekly data: call get_rework_weekly_data for week_range 2026-W23.', type='reasoning_text')], encrypted_content=None, status=None), ResponseFunctionToolCall(arguments='{\n  "week_range": "2026-W23",\n  "lookback_weeks": 4,\n  "trend_weeks": 6\n}', call_id='call_04da636ef94247b3ab35e28a493f5040', name='get_rework_weekly_data', type='function_call', id='ft_04da636ef94247b3ab35e28a493f5040', status=None)], usage=Usage(requests=1, input_tokens=0, input_tokens_details=Inpu